PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
DEFAULT_PASSWORD=change-me-before-seeding

# Investor email mapping for `npm run seed`. Format: CODE:email,CODE:email
# Codes: HH, HS, ØS, JC, HF. Falls back to <code>@example.local if unset.
GEYSIR_USER_EMAILS=

# Email that should be granted the "admin" role during migrate-to-sheet.
GEYSIR_ADMIN_EMAIL=

# Path to the Google Cloud service account JSON key used to sync the Nordnet
# Google Sheet. Create the service account at console.cloud.google.com, then
# share the sheet with its client_email as Viewer.
GOOGLE_SERVICE_ACCOUNT_KEY=./data/google-service-account.json
